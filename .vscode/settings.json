{
  "github.copilot.chat.defaultMode": "*Thunai",
  "chat.agent.enabled": true,
  "github.copilot.chat.agent.autoApproveMode": "none",
  "chat.useAgentsMdFile": true,
  "chat.tools.terminal.autoApprove": {
    "/^git\\s+(add|commit|push|merge|rebase|reset|checkout|switch|restore|rm|mv|stash|tag|cherry-pick|revert|clean|pull)\\b/": false,
    "/^gh\\s+(pr|issue|release|repo|workflow)\\s+(create|merge|edit|close|reopen|comment|review|ready|delete|run|fork)\\b/": false
  }
}
